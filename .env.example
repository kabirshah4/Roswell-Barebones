# Copy to .env and fill in. .env is gitignored and must never be committed.
# Every key here is optional — Roswell runs without any of them, and each
# panel says what it is missing rather than failing silently.

# Macro calendar (ECO). Free: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# The analyst chat and news enrichment. Either one is enough.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# https://aistudio.google.com/apikey  — has a free tier, 20 requests/day
GEMINI_API_KEY=

# Push computed setups and triggered price alerts to a channel. Can also be
# set from Settings in the UI, which stores it in the database instead.
DISCORD_WEBHOOK_URL=

# Market screener endpoint, used by three features: the searchable symbol
# catalogue, the whole-market Scanner panel, and the IMAP sector map. Roswell
# ships without one, and those three say "no screener source configured"
# until you set it. See "Bring your own screener" in the README for the
# request and response shape expected. `{market}` is substituted per market.
SCREENER_SCAN_URL=

# Only needed if you reach the terminal by a hostname other than localhost.
# Comma-separated. See "Locking the terminal" in the README.
ROSWELL_ALLOWED_HOSTS=
